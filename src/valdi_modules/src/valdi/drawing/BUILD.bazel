load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@valdi//bzl/valdi:valdi_module.bzl", "valdi_module")

ts_project(
    name = "drawing_web",
    srcs = glob([
        "web/**/*.ts",
        "src/**/*.d.ts",
    ]),
    allow_js = True,
    composite = True,
    declaration = True,
    transpiler = "tsc",
    tsconfig = "web/tsconfig.json",
    deps = [
        "//:valdi_core_link",
        "//:valdi_tsx_link",
    ],
)

valdi_module(
    name = "drawing",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
    ]) + [
        "tsconfig.json",
    ],
    android_class_path = "com.snap.modules.drawing",
    android_output_target = "release",
    ios_module_name = "SCCDrawing",
    ios_output_target = "release",
    single_file_codegen = True,
    visibility = ["//visibility:public"],
    web_deps = [":drawing_web"],
    web_register_native_module_id_overrides = {
        "drawing/web/BitmapNative.js": "drawing/src/BitmapNative",
        # drawing/src/Drawing.ts does require('Drawing') to get the native provider
        "drawing/web/DrawingModuleProvider.js": "Drawing",
        "drawing/web/FontManagerNative.js": "drawing/src/FontManagerNative",
        "drawing/web/ManagedContextNative.js": "drawing/src/ManagedContextNative",
    },
    deps = [
        "@valdi//src/valdi_modules/src/valdi/valdi_core",
    ],
    test_deps = [
        "@valdi//src/valdi_modules/src/valdi/jasmine",
        "@valdi//src/valdi_modules/src/valdi/valdi_test",
    ],
)
