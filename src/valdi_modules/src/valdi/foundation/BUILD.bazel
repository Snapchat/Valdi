load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("//bzl/valdi:valdi_module.bzl", "valdi_module")

npm_package(
    name = "foundation_dts",
    srcs = glob([
        "src/**/*.d.ts",
    ]),
    package = "foundation",
    visibility = ["//visibility:public"],
)

valdi_module(
    name = "foundation",
    srcs = glob([
        "src/**/*.js",
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.js",
        "test/**/*.ts",
        "test/**/*.tsx",
    ]) + [
        "tsconfig.json",
    ],
    android_class_path = "com.snap.modules.foundation",
    android_output_target = "release",
    ios_module_name = "SCCFoundation",
    ios_output_target = "release",
    single_file_codegen = True,
    visibility = ["//visibility:public"],
    deps = [
        "//src/valdi_modules/src/valdi/valdi_core",
        "//src/valdi_modules/src/valdi/valdi_tsx",
    ],
    test_deps = [
        "//src/valdi_modules/src/valdi/jasmine",
        "//src/valdi_modules/src/valdi/valdi_test",
    ],
)
