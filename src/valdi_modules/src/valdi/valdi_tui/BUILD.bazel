load("//bzl/valdi:valdi_module.bzl", "valdi_module")

# Terminal UI renderer for Valdi CLI applications. It renders through the native terminal backend
# (//valdi:valdi_terminal), so it is only meaningful under hosts that register it, such as the
# standalone runtime; no native exports are generated for iOS or Android.
valdi_module(
    name = "valdi_tui",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
    ]) + [
        "tsconfig.json",
    ],
    android_output_target = "debug",
    compilation_mode = "js",
    has_android_exports = False,
    has_ios_exports = False,
    ios_module_name = "SCCValdiTUI",
    ios_output_target = "debug",
    native_deps = ["@valdi//valdi:valdi_terminal"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/valdi_modules/src/valdi/jasmine",
        "//src/valdi_modules/src/valdi/valdi_core",
    ],
)
