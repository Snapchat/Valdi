try-import %workspace%/.bazelrc.internal
try-import %workspace%/.bazelrc.local

# Shared with the opt-in Linux host; keep its compiler/toolchain flags aligned.
import %workspace%/bzl/valdi/common.bazelrc

common --bes_instance_name=client
common --enable_platform_specific_config

# Flags for compilation
common --define enable_web=true

## Disable sandboxing for macs, both laptops and in CI; the performance hit is much too high.
build:macos --spawn_strategy=local
build:linux --sandbox_writable_path=/var/tmp

# iOS and Apple cc changes and hacks
## For Objective-C source files
build --per_file_copt=.*\.mm\$@-std=c++20
build --host_per_file_copt=.*\.mm\$@-std=c++20
build --ios_minimum_os=15.0

## TODO: (dchapp) this is currently needed otherwise -O0 and -DDEBUG=1 get passed to compilations of .mm/.m for production flavor builds
build --experimental_objc_fastbuild_options=""
## HACK inject this in the default toolchain which is only used on macos until we switch to bazel_toolchains
build:macos --copt=-fvisibility=hidden

# java configuration
## Disable some java checks for now, djinni generates code that errors out
build --javacopt=-XepDisableAllChecks
## rules_java 8.13.0 emits the java launcher's JAVABIN with the pre-Bazel-8 external/ prefix
## (JAVABIN=external/rules_java++toolchains+<jdk>/bin/java, resolved under $JAVA_RUNFILES/_main/)
## while emitting the classpath with Bazel 8's layout, where external repos sit at the runfiles
## root. The JDK is therefore never found and every java_test dies with exit 126 before running a
## line. Restoring the legacy runfiles tree makes both spellings resolve.
##
## Stopgap: this flag is deprecated and will eventually be removed from Bazel. The durable fix is a
## rules_java bump past 8.13.0, at which point this line should go.
build --legacy_external_runfiles

build --define=android_dexmerger_tool=d8_dexmerger
build --define=android_incremental_dexing_tool=d8_dexbuilder
build --define=android_standalone_dexing_tool=d8_compat_dx
build --incremental_dexing

# Disable 3rd party libs warnings (bzlmod canonical names use module~ suffix)
build --per_file_copt=external/protobuf[^/]*/.*\$@-Wno-everything
build --per_file_copt=external/boringssl[^/]*/.*\$@-Wno-everything

## Disable sandboxing for macs, both laptops and in CI; the performance hit is much too high.
build:macos --spawn_strategy=local
build:linux --sandbox_writable_path=/var/tmp

# Disk cache disabled by default for internal builds (saves disk space on dev machines).
# CI overrides this via .bazelrc.ci which is imported last (see bottom of file).
# https://docs.google.com/document/d/1N8W_M83n9jhMi7pgUhXuEuxypb3dmlHBu_CG_eXipXI/edit?usp=sharing
build --disk_cache=""

# common build configuration
build --generate_json_trace_profile
# enable grpc log
build --remote_grpc_log=/tmp/snap_client_grpc.log
build --experimental_reuse_sandbox_directories

# Default JS engine
build --flag_alias=valdi_js_engine=@valdi//bzl/valdi:js_engine
build --valdi_js_engine=hermes

common --@aspect_rules_ts//ts:skipLibCheck=always

# cargo-bazel computes platform-specific lock digests (the binary itself
# differs per OS), so a lockfile generated on macOS will fail validation
# on Linux and vice versa. Auto-repin so builds work on any platform.
build --repo_env=CARGO_BAZEL_REPIN=true

# AddressSanitizer, used by the nightly sanitizer job (tools/ci/sanitizer_tests.sh) to catch
# teardown / threading memory-safety bugs (use-after-free, heap corruption) that an optimized build
# hides. Instrumented and not remotely cached, so it is a slow full build -- nightly / manual only,
# never per-PR. Hermes is excluded at the test level (its parser trips a benign stack-use-after-scope
# under ASan); the QuickJS engines cover the ThreadedDispatchQueue teardown paths.
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-Og
build:asan --copt=-g
build:asan --copt=-Wno-macro-redefined
build:asan --linkopt=-fsanitize=address
build:asan --test_env=ASAN_OPTIONS=detect_leaks=0:halt_on_error=1
