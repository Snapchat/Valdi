try-import %workspace%/.bazelrc.internal
try-import %workspace%/.bazelrc.local

# Enable bzlmod for module-based dependency resolution
common --enable_bzlmod
common --noenable_workspace

# Bazel 8 flipped this to true by default; overlay/vendored/generated dirs
# (websocketpp overlay, yoga, djinni, dist_dev, etc.) glob empty at load time.
common --noincompatible_disallow_empty_glob

# rules_kotlin 1.9.5's kt_kotlinc_options returns a struct from its rule impl,
# which Bazel 8 disallows by default. Re-enable the legacy syntax until
# rules_kotlin is upgraded.
common --incompatible_disallow_struct_provider_syntax=false

common --bes_instance_name=client
common --enable_platform_specific_config

# Disable workers for repo fetching to prevent OOM
common --experimental_worker_for_repo_fetching=off

# android configuration
# Expose AndroidResourceInfo provider to Kotlin rules
common --experimental_google_legacy_api=true
common --experimental_enable_android_migration_apis=true
common --incompatible_java_common_parameters=false

# Flags for compilation
common --define enable_web=true

build --tool_java_language_version=17
build --java_language_version=11

## Disable sandboxing for macs, both laptops and in CI; the performance hit is much too high.
build:macos --spawn_strategy=local
build:linux --sandbox_writable_path=/var/tmp

# common cc configuration
build --cxxopt=-std=c++20
build --cxxopt=-Wno-ambiguous-reversed-operator
build --cxxopt=-Wno-gcc-compat
build --cxxopt=-Wno-nullability-extension
build --cxxopt=-D_LIBCPP_ENABLE_CXX20_REMOVED_TYPE_TRAITS
build --host_cxxopt=-std=c++20
build --host_cxxopt=-Wno-nullability-extension

## we need to disable this due to a bug in bazel
## see https://github.com/bazelbuild/bazel/issues/12381
build --incompatible_use_specific_tool_files=false

# iOS and Apple cc changes and hacks
## For Objective-C source files
build --per_file_copt=.*\.mm\$@-std=c++20
build --host_per_file_copt=.*\.mm\$@-std=c++20
build --ios_minimum_os=15.0

## TODO: (dchapp) this is currently needed otherwise -O0 and -DDEBUG=1 get passed to compilations of .mm/.m for production flavor builds
build --experimental_objc_fastbuild_options=""
## HACK inject this in the default toolchain which is only used on macos until we switch to bazel_toolchains
build:macos --copt=-fvisibility=hidden

# java configuration
## Disable some java checks for now, djinni generates code that errors out
build --javacopt=-XepDisableAllChecks
build --java_runtime_version=remotejdk_11
build --tool_java_runtime_version=remotejdk_17
## rules_java 8.13.0 emits the java launcher's JAVABIN with the pre-Bazel-8 external/ prefix
## (JAVABIN=external/rules_java++toolchains+<jdk>/bin/java, resolved under $JAVA_RUNFILES/_main/)
## while emitting the classpath with Bazel 8's layout, where external repos sit at the runfiles
## root. The JDK is therefore never found and every java_test dies with exit 126 before running a
## line. Restoring the legacy runfiles tree makes both spellings resolve.
##
## Stopgap: this flag is deprecated and will eventually be removed from Bazel. The durable fix is a
## rules_java bump past 8.13.0, at which point this line should go.
build --legacy_external_runfiles

build --flag_alias=snap_flavor=@snap_platforms//flavors:snap_flavor
build --snap_flavor=client_development

build --define=android_dexmerger_tool=d8_dexmerger
build --define=android_incremental_dexing_tool=d8_dexbuilder
build --define=android_standalone_dexing_tool=d8_compat_dx
build --incremental_dexing

# Disable 3rd party libs warnings (bzlmod canonical names use module~ suffix)
build --per_file_copt=external/protobuf[^/]*/.*\$@-Wno-everything
build --per_file_copt=external/boringssl[^/]*/.*\$@-Wno-everything

# Enable persistent worker for Valdi compilation
build --strategy=ValdiCompile=worker

## Disable sandboxing for macs, both laptops and in CI; the performance hit is much too high.
build:macos --spawn_strategy=local
build:linux --sandbox_writable_path=/var/tmp

# Disk cache disabled by default for internal builds (saves disk space on dev machines).
# CI overrides this via .bazelrc.ci which is imported last (see bottom of file).
# https://docs.google.com/document/d/1N8W_M83n9jhMi7pgUhXuEuxypb3dmlHBu_CG_eXipXI/edit?usp=sharing
build --disk_cache=""

# common build configuration
build --generate_json_trace_profile
# enable grpc log
build --remote_grpc_log=/tmp/snap_client_grpc.log
build --experimental_reuse_sandbox_directories

# Default JS engine
build --flag_alias=valdi_js_engine=@valdi//bzl/valdi:js_engine
build --valdi_js_engine=hermes

# Valdi Open Source Flags
build --define=open_source_build=true

common --@aspect_rules_ts//ts:skipLibCheck=always

# cargo-bazel computes platform-specific lock digests (the binary itself
# differs per OS), so a lockfile generated on macOS will fail validation
# on Linux and vice versa. Auto-repin so builds work on any platform.
build --repo_env=CARGO_BAZEL_REPIN=true

# Remote cache (activated in CI via .bazelrc.local)
build:ci --experimental_circuit_breaker_strategy=failure

# AddressSanitizer, used by the nightly sanitizer job (tools/ci/sanitizer_tests.sh) to catch
# teardown / threading memory-safety bugs (use-after-free, heap corruption) that an optimized build
# hides. Instrumented and not remotely cached, so it is a slow full build -- nightly / manual only,
# never per-PR. Hermes is excluded at the test level (its parser trips a benign stack-use-after-scope
# under ASan); the QuickJS engines cover the ThreadedDispatchQueue teardown paths.
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-Og
build:asan --copt=-g
build:asan --copt=-Wno-macro-redefined
build:asan --linkopt=-fsanitize=address
build:asan --test_env=ASAN_OPTIONS=detect_leaks=0:halt_on_error=1

# Strict Android C++: compiles Valdi's Android C++ the way a larger Android app that vendors Valdi
# does, so code that only breaks under those flags fails public CI instead of failing downstream.
# Used by tools/ci/build_android_cpp_strict.sh; arm64-only (the --target override below is arm64).
#
# The default public Android build uses rules_android_ndk's toolchain, which differs in three ways
# that hide real -Werror failures:
#   1. It targets API 31. Downstream builds target API 21, where bionic hides newer libc symbols
#      (aligned_alloc, getrandom, ...) and using them is a hard "undeclared identifier" error.
#   2. Its default flags pass -Wno-deprecated, so C++20 deprecations (enum-enum arithmetic,
#      implicit [=] capture of this, volatile compound ops, ...) never reach Valdi's -Werror.
#   3. It passes -Wno-* for a batch of warnings clang enables by default (return-type-c-linkage,
#      final-dtor-non-final-class, implicit-const-int-float-conversion, ...). -Wall/-Wextra in
#      Valdi's copts don't turn these back on because they aren't in those groups.
# --copt lands after the toolchain's flags and before each target's copts, so this re-enables
# exactly clang's default-on diagnostics and per-target -Wno-* still win, as they do downstream.
build:android_strict_cxx --platforms=@snap_platforms//os:android_arm64
build:android_strict_cxx --compilation_mode=dbg
build:android_strict_cxx --copt=--target=aarch64-linux-android21
build:android_strict_cxx --copt=-Og
build:android_strict_cxx --copt=-DANDROID
build:android_strict_cxx --copt=-DANDROID_WITH_JNI
build:android_strict_cxx --copt=-DBAZEL_BUILD=1
build:android_strict_cxx --copt=-DDJINNI_DISABLE_DESCRIPTION_METHODS
build:android_strict_cxx --copt=-Wno-unknown-warning-option
## (2) C++20 deprecations: the group, minus its members clang leaves off by default.
build:android_strict_cxx --copt=-Wdeprecated
build:android_strict_cxx --copt=-Wno-deprecated-copy
build:android_strict_cxx --copt=-Wno-deprecated-copy-with-dtor
build:android_strict_cxx --copt=-Wno-deprecated-copy-with-user-provided-copy
build:android_strict_cxx --copt=-Wno-deprecated-copy-with-user-provided-dtor
build:android_strict_cxx --copt=-Wno-deprecated-dynamic-exception-spec
build:android_strict_cxx --copt=-Wno-deprecated-literal-operator
build:android_strict_cxx --copt=-Wno-deprecated-redundant-constexpr-static-def
## (3) Default-on warnings the NDK toolchain turns off.
build:android_strict_cxx --copt=-Wambiguous-member-template
build:android_strict_cxx --copt=-Wdynamic-exception-spec
build:android_strict_cxx --copt=-Wextern-c-compat
build:android_strict_cxx --copt=-Wfinal-dtor-non-final-class
build:android_strict_cxx --copt=-Wgnu-alignof-expression
build:android_strict_cxx --copt=-Wgnu-variable-sized-type-not-at-end
build:android_strict_cxx --copt=-Wignored-optimization-argument
build:android_strict_cxx --copt=-Wimplicit-const-int-float-conversion
build:android_strict_cxx --copt=-Winvalid-source-encoding
build:android_strict_cxx --copt=-Wpointer-sign
build:android_strict_cxx --copt=-Wprivate-header
build:android_strict_cxx --copt=-Wreserved-user-defined-literal
build:android_strict_cxx --copt=-Wreturn-type-c-linkage
build:android_strict_cxx --copt=-Wsigned-unsigned-wchar
build:android_strict_cxx --copt=-Wtrigraphs
build:android_strict_cxx --copt=-Wuser-defined-warnings
## Warnings the downstream build turns off globally (so this config isn't stricter than it).
build:android_strict_cxx --copt=-Wno-deprecated-builtins
build:android_strict_cxx --copt=-Wno-nontrivial-memcall
build:android_strict_cxx --cxxopt=-Wno-unused-private-field
## Downstream C++ codegen: no C++17 aligned new, no exit-time destructors for statics.
build:android_strict_cxx --cxxopt=-fno-aligned-allocation
build:android_strict_cxx --cxxopt=-fno-c++-static-destructors
