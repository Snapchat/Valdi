load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "calculator_linux",
    srcs = ["main.cpp"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//valdi_linux_window:valdi_window_application",
        "@sdl3//:sdl3",
        "@valdi//apps/calculator:calculator_native",
        "@valdi//valdi_core:valdi_core_cc",
    ],
)

# Deterministic theme source; still uses the real SDL event loop and Valdi runtime.
cc_binary(
    name = "calculator_linux_theme_test",
    testonly = True,
    srcs = ["main.cpp", "//valdi_linux_window:test/SystemThemeStub.cpp"],
    copts = ["-DVALDI_LINUX_THEME_TEST"],
    linkopts = ["-Wl,--wrap=SDL_GetSystemTheme"],
    tags = ["manual", "requires-display"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//valdi_linux_window:valdi_window_application",
        "@sdl3//:sdl3",
        "@valdi//apps/calculator:calculator_native",
        "@valdi//valdi_core:valdi_core_cc",
    ],
)
