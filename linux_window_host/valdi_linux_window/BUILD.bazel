load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(["test/SystemThemeStub.cpp"])

cc_library(
    name = "sdl_window_host",
    srcs = ["SDLWindowHost.cpp"],
    hdrs = ["SDLWindowHost.hpp"],
    copts = ["-fno-exceptions"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":framebuffer",
        "@sdl3",
        "@valdi//snap_drawing:snap_drawing_cc",
        "@valdi//valdi_core:valdi_core_cc",
    ],
)

cc_library(
    name = "framebuffer",
    hdrs = ["Framebuffer.hpp"],
)

cc_library(
    name = "valdi_window_application",
    srcs = ["ValdiWindowApplication.cpp"],
    hdrs = ["ValdiWindowApplication.hpp"],
    copts = ["-fno-exceptions"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":sdl_window_host",
        "@valdi//snap_drawing:snap_drawing_cc",
        "@valdi//valdi:valdi_linux",
        "@valdi//valdi:valdi_snap_drawing",
        "@valdi//valdi_core:valdi_core_cc",
    ],
)

cc_test(
    name = "framebuffer_test",
    srcs = ["test/FramebufferTest.cpp"],
    deps = [":framebuffer"],
)

# Run headless with SDL_VIDEODRIVER=offscreen; no display server is required.
cc_test(
    name = "sdl_window_host_test",
    size = "small",
    timeout = "short",
    srcs = [
        "test/SDLWindowHostTest.cpp",
        "test/SystemThemeStub.cpp",
    ],
    env = {
        "SDL_FRAMEBUFFER_ACCELERATION": "0",
        "SDL_VIDEODRIVER": "offscreen",
    },
    linkopts = ["-Wl,--wrap=SDL_GetSystemTheme"],
    # Match @valdi//snap_drawing:test: the drawing/Skia closure links statically.
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":sdl_window_host",
        "@sdl3",
        "@valdi//snap_drawing:snap_drawing_cc",
        "@valdi//valdi_core:valdi_core_cc",
    ],
)
