# Test-only artifacts, kept in a separate namespace from android_mvn so
# testonly targets (e.g. valdi_android_test_support) don't leak test libraries
# into production classpaths. In the internal linked build this repo is
# overridden to Snap's @test_mvn (see android/snapchat/MODULE.bazel).
maven.install(
    name = "test_mvn",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.test:core:1.5.0",
        "androidx.test.espresso:espresso-core:3.5.1",
        "androidx.test.ext:junit:1.1.5",
        "androidx.test:monitor:1.6.0",
        "androidx.test:runner:1.5.0",
        "junit:junit:4.13.2",
        "org.hamcrest:hamcrest-core:1.3",
        "org.hamcrest:hamcrest-library:1.3",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
    ],
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
)
use_repo(maven, "test_mvn")

