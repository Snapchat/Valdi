[0.4, "o", "[0m\r\n\u2502                      \u2502 \u001b[2m\u2502\u001b[0m                                                     \u001b[2m\u2502\u001b[0m\r\n\u2502 \u001b[7;32m\u2714 Build runtime\u001b[0m      \u2502 \u001b[2m\u2502\u001b[0m Compiles the C++ runtime with QuickJS and the Yoga  \u001b[2m\u2502\u001b[0m\r\n\u2502 \u001b[32m\u2714 Compile module\u001b[0m     \u2502 \u001b[2m\u2502\u001b[0m layout engine.                                      \u001b[2m\u2502\u001b[0m\r\n\u2502   Render frame       \u2502 \u001b[2m\u2502\u001b[0m                                                     \u001b[2m\u2502\u001b[0m\r\n\u2502   Ship it            \u2502 \u001b[2m\u2502\u001b[0m \u001b[2m\u2191/\u2193 move \u00b7 type a note \u00b7 enter log \u00b7 esc quit\u001b[0m       \u001b[2m\u2502\u001b[0m\r\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518 \u001b[2m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n\u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
