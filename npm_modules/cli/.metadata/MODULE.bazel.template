module(name = "{{WORKSPACE_NAME}}", version = "0.1")

# -- Valdi framework (https://github.com/Snapchat/Valdi) ---------------------
VALDI_TAG = "{{VALDI_RELEASE_TAG}}"
VALDI_URL = "https://github.com/Snapchat/Valdi/archive/" + VALDI_TAG + ".tar.gz"
VALDI_PREFIX = "Valdi-" + VALDI_TAG

bazel_dep(name = "valdi", version = "0.1")
archive_override(
    module_name = "valdi",
    urls = [VALDI_URL],
    strip_prefix = VALDI_PREFIX,
)

# Valdi internal sub-modules: local_path_override in Valdi's own MODULE.bazel
# only takes effect when Valdi is the root module. Consumers must provide
# archive_override entries that point into the Valdi release archive.
bazel_dep(name = "android_macros")
archive_override(module_name = "android_macros", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/macros")

bazel_dep(name = "snap_macros")
archive_override(module_name = "snap_macros", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/valdi/snap_macros")

bazel_dep(name = "snap_client_toolchains")
archive_override(module_name = "snap_client_toolchains", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/toolchains")

bazel_dep(name = "snap_platforms")
archive_override(module_name = "snap_platforms", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/platforms")

bazel_dep(name = "skia_user_config")
archive_override(module_name = "skia_user_config", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/third-party/skia_user_config")

bazel_dep(name = "rules_hdrs")
archive_override(module_name = "rules_hdrs", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/third-party/rules_hdrs")

bazel_dep(name = "valdi_toolchain")
archive_override(module_name = "valdi_toolchain", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bin")

# -- Valdi Widgets (https://github.com/Snapchat/Valdi_Widgets) ---------------
WIDGETS_TAG = "{{VALDI_WIDGETS_RELEASE_TAG}}"

bazel_dep(name = "valdi_widgets")
archive_override(
    module_name = "valdi_widgets",
    urls = ["https://github.com/Snapchat/Valdi_Widgets/archive/" + WIDGETS_TAG + ".tar.gz"],
    strip_prefix = "Valdi_Widgets-" + WIDGETS_TAG,
)

# -- C++ toolchains (Apple CC before LLVM for ObjC priority) ------------------
valdi_toolchains = use_extension("@valdi//bzl:valdi_toolchains.bzl", "valdi_toolchains")
use_repo(valdi_toolchains, "local_config_apple_cc_toolchains", "local_config_apple_cc", "llvm_toolchain", "llvm_toolchain_llvm")
register_toolchains("@local_config_apple_cc_toolchains//:all")
register_toolchains("@llvm_toolchain//:all")

# -- Android dependencies ----------------------------------------------------
bazel_dep(name = "rules_java", version = "7.4.0")
bazel_dep(name = "rules_android", version = "0.6.5")
# Resolve rules_android from the Valdi registry, which carries the hermetic Android SDK
# patch (registry/modules/rules_android/0.6.5) so bootstrapped apps build Android targets
# with no local ANDROID_HOME.
single_version_override(module_name = "rules_android", version = "0.6.5")
bazel_dep(name = "rules_android_ndk", version = "0.1.3")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_gmaven_r8", "android_tools")

hermetic_android_sdk_extension = use_extension("@valdi//bzl:hermetic_android_sdk.bzl", "hermetic_android_sdk_extension")
hermetic_android_sdk_extension.configure(
    api_level = 36,
    build_tools_version = "34.0.0",
)
use_repo(hermetic_android_sdk_extension, "androidsdk")

register_toolchains(
    "@rules_android//toolchains/android:all",
    "@rules_android//toolchains/android_sdk:all",
)
register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")

hermetic_ndk_extension = use_extension("@valdi//bzl:hermetic_ndk.bzl", "hermetic_ndk_extension")
use_repo(hermetic_ndk_extension, "androidndk")

register_toolchains("@androidndk//:all")

bazel_dep(name = "rules_kotlin", version = "1.9.0")
single_version_override(module_name = "rules_kotlin", version = "1.9.0")
bazel_dep(name = "rules_jvm_external", version = "6.2")

# -- Maven (Android) ---------------------------------------------------------
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

maven.install(
    name = "android_mvn",
    artifacts = [
        "androidx.annotation:annotation:1.1.0",
        "androidx.appcompat:appcompat:1.2.0",
        "androidx.appcompat:appcompat-resources:1.2.0",
        "androidx.collection:collection:1.1.0",
        "androidx.constraintlayout:constraintlayout:2.1.4",
        "androidx.core:core:1.6.0",
        "androidx.customview:customview:1.1.0",
        "androidx.dynamicanimation:dynamicanimation:1.0.0",
        "androidx.fragment:fragment:1.1.0",
        "androidx.interpolator:interpolator:1.0.0",
        "androidx.lifecycle:lifecycle-common:2.2.0",
        "androidx.lifecycle:lifecycle-process:2.2.0",
        "androidx.lifecycle:lifecycle-viewmodel:2.2.0",
        "androidx.recyclerview:recyclerview:1.2.1",
        "androidx.test:core:1.5.0",
        "androidx.test.ext:junit:1.1.3",
        "androidx.test:monitor:1.5.0",
        "androidx.test:runner:1.5.0",
        "com.google.android.material:material:1.2.0",
        "com.google.code.findbugs:jsr305:3.0.2",
        "com.google.code.gson:gson:2.8.6",
        "com.google.protobuf.nano:protobuf-javanano:3.1.0",
        "com.jakewharton.timber:timber:4.7.1",
        "com.squareup.leakcanary:leakcanary-android:2.10",
        "com.squareup.okhttp3:okhttp:4.9.0",
        "com.squareup.okio:okio:2.10.0",
        "io.reactivex.rxjava3:rxandroid:3.0.0",
        "io.reactivex.rxjava3:rxjava:3.1.0",
        "io.reactivex.rxjava3:rxkotlin:3.0.0",
        "javax.inject:javax.inject:1",
        "junit:junit:4.13.2",
        "org.junit.jupiter:junit-jupiter-api:5.9.3",
        "org.junit.jupiter:junit-jupiter-engine:5.9.3",
        "org.junit.jupiter:junit-jupiter-params:5.9.3",
        "org.junit.platform:junit-platform-console:1.9.2",
        "org.junit.platform:junit-platform-launcher:1.9.2",
        "org.junit.platform:junit-platform-reporting:1.9.2",
        "org.junit.vintage:junit-vintage-engine:5.9.3",
        "org.robolectric:android-all:10-robolectric-5803371",
        "org.robolectric:annotations:4.10.3",
        "org.robolectric:robolectric:4.10.3",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
    ],
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
    lock_file = "//:android_mvn_install.json",
)

use_repo(maven, "android_mvn")

# Unpinned maven repos are resolved by coursier straight from Maven Central,
# which rate-limits (HTTP 429). With a lock file Bazel's downloader fetches
# each jar by checksum instead. The root module's lock file wins for a namespace,
# and Valdi's own pins for these namespaces don't reach this app, so the app
# pins the ones an Android build fetches. A root tag also replaces the
# namespace's repositories, so each repeats its declaring module's list.
# After changing artifacts or bumping a declaring module, repin with
# `REPIN=1 bazel run @unpinned_<name>//:pin` (add the name to use_repo first).
maven.install(
    name = "android_ide_common_30_1_3",
    lock_file = "//:android_ide_common_30_1_3_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
)
maven.install(
    name = "maven",
    lock_file = "//:maven_install.json",
)
maven.install(
    name = "rules_android_maven",
    lock_file = "//:rules_android_maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
)

# -- Version pins (must match Valdi's MODULE.bazel) ---------------------------
single_version_override(module_name = "protobuf", version = "27.0")
single_version_override(module_name = "rules_apple", version = "4.0.0")
single_version_override(module_name = "rules_pkg", version = "0.9.1")
single_version_override(module_name = "zlib", version = "1.3.2")

# rules_python 1.9.0's hermetic Python toolchain bundles setuptools files whose
# names contain spaces (e.g. "Lorem ipsum.txt"), which Bazel's build-runfiles
# cannot materialize on macOS. The patch renames them. It is vendored into this
# app (bzl/patches/...) and referenced with a root-local `//` label on purpose:
# bzlmod only applies this override from the ROOT module, and `@valdi` resolves
# to the pinned public release, which may not ship the patch. See the CLI
# README ("Bootstrap pins and patches").
bazel_dep(name = "rules_python", version = "1.9.0")
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.single_version_platform_override(
    patch_strip = 1,
    patches = ["//bzl/patches/rules_python/1.9.0:remove_setuptools_spaces.patch"],
    platform = "aarch64-apple-darwin",
    python_version = "3.11.14",
)

# -- Rust toolchain ------------------------------------------------------------
# rules_rust only honors rust.toolchain() from the root module, so Valdi's own
# toolchain config does not reach bootstrapped apps. Mirror it here.
# -Cstrip=none for exec-config (host tool / proc-macro) builds: rustc's
# debuginfo strip leaves a misaligned LINKEDIT string table that macOS 27 dyld
# rejects when the dylib was linked against SDK 27 (rust-lang/rust#157750,
# fixed in Rust 1.98.0).
bazel_dep(name = "rules_rust", version = "0.64.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_exec_rustc_flags = ["-Cstrip=none"],
    extra_target_triples = [
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "armv7-linux-androideabi",
        "x86_64-apple-ios",
        "x86_64-linux-android",
    ],
    versions = ["1.87.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
