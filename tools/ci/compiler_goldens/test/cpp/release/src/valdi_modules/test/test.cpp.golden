#include "valdi_core/cpp/Marshalling/CppMarshaller.hpp"
#include "valdi_modules/test/test.hpp"

namespace snap::valdi_modules::test {

  class ICalculatorProxy: public ICalculator {
    public:
    using AddFn = Valdi::Function<void(double)>;
    using SubFn = Valdi::Function<void(double)>;
    using MulFn = Valdi::Function<void(double)>;
    using DivFn = Valdi::Function<void(double)>;
    using TotalFn = Valdi::Function<double()>;
    using ToStringFn = Valdi::Function<Valdi::StringBox(CalculatorToStringFormat)>;

    ICalculatorProxy() = default;
    ~ICalculatorProxy() override = default;

    void add(double value) final {
      _add(value);
    }

    void sub(double value) final {
      _sub(value);
    }

    void mul(double value) final {
      _mul(value);
    }

    void div(double value) final {
      _div(value);
    }

    double total() final {
      return _total();
    }

    Valdi::StringBox toString(CalculatorToStringFormat format) final {
      return _toString(format);
    }

    static void unmarshall(Valdi::ExceptionTracker &exceptionTracker, const Valdi::Value &value, Valdi::Ref<ICalculatorProxy> &out) {
      out = Valdi::makeShared<ICalculatorProxy>();
      auto &self = *out;
      Valdi::CppMarshaller::unmarshallTypedObject(exceptionTracker, *getRegisteredClass(), value, self._add, self._sub, self._mul, self._div, self._total, self._toString);
    }

    private:
    AddFn _add;
    SubFn _sub;
    MulFn _mul;
    DivFn _div;
    TotalFn _total;
    ToStringFn _toString;
  };

  ICalculator::ICalculator(): Valdi::CppGeneratedInterface(getRegisteredClass()) {
  }

  void ICalculator::unmarshall(Valdi::ExceptionTracker &exceptionTracker, const Valdi::Value &value, Valdi::Ref<ICalculator> &out) {
    Valdi::CppMarshaller::unmarshallProxyObject<ICalculatorProxy>(exceptionTracker, *getRegisteredClass(), value, out);
  }

  void ICalculator::marshall(Valdi::ExceptionTracker &exceptionTracker, const Valdi::Ref<ICalculator> &value, Valdi::Value &out) {
    Valdi::CppMarshaller::marshallProxyObject(exceptionTracker, *getRegisteredClass(), *value, out, [&]() {
      Valdi::CppMarshaller::marshallTypedObject(exceptionTracker, *getRegisteredClass(), out, Valdi::CppMarshaller::methodToFunction<ICalculator, &ICalculator::add>(value), Valdi::CppMarshaller::methodToFunction<ICalculator, &ICalculator::sub>(value), Valdi::CppMarshaller::methodToFunction<ICalculator, &ICalculator::mul>(value), Valdi::CppMarshaller::methodToFunction<ICalculator, &ICalculator::div>(value), Valdi::CppMarshaller::methodToFunction<ICalculator, &ICalculator::total>(value), Valdi::CppMarshaller::methodToFunction<ICalculator, &ICalculator::toString>(value));
    });
  }

  Valdi::RegisteredCppGeneratedClass *ICalculator::getRegisteredClass() {
    static auto *kRegisteredClass = Valdi::CppGeneratedClass::registerSchema("c+ 'snap::valdi_modules::test::ICalculator'{'add':f|m|(d), 'sub':f|m|(d), 'mul':f|m|(d), 'div':f|m|(d), 'total':f|m|(): d, 'toString':f|m|(r<e>:'[0]'): s}", []() -> Valdi::TypeReferencesVec {
      return {::snap::valdi_modules::test::getRegisteredEnumClass(static_cast<const CalculatorToStringFormat *>(nullptr))};
    });

    return kRegisteredClass;
  }

}

