#import <valdi_core/SCValdiBuiltinTrampolines.h>
#import <valdi_core/SCValdiMarshallableObjectDescriptor.h>

#import "SCCTestTypes.h"

@implementation SCCTestMyModel

@dynamic i;
@dynamic s;
@dynamic b;

- (instancetype _Nonnull)initWithI:(double)i s:(NSString * _Nonnull)s b:(BOOL)b
{
    return [super initWithFieldValues:nil, i, s, b];
}

+ (SCValdiMarshallableObjectDescriptor)valdiMarshallableObjectDescriptor
{
    static const SCValdiMarshallableObjectFieldDescriptor kFields[] = {
        {.name = "i", .selName = nil, .type = "d"},
        {.name = "s", .selName = nil, .type = "s"},
        {.name = "b", .selName = nil, .type = "b"},
        {.name = nil},
    };
    return SCValdiMarshallableObjectDescriptorMake(kFields, nil, nil, SCValdiMarshallableObjectTypeClass);
}

@end


